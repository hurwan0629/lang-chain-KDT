<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>방명록</title>
  <link rel="stylesheet" href="/resources/style.css">
</head>
<body>
  <main class="page-shell">
    <header class="site-header">
      <a class="brand" href="/" aria-label="방명록 홈">
        <span class="brand-mark">G</span>
        <span>Guestbook</span>
      </a>
      <nav class="header-actions" aria-label="회원 메뉴">
        <% if(!loggedIn) { %>
          <a class="text-link" href="/login">로그인</a>
          <a class="button button-small" href="/regist">회원가입</a>
        <% } else { %>
          <span class="welcome"><strong><%= userName %></strong>님, 반가워요</span>
          <a class="text-link" href="/logout">로그아웃</a>
        <% } %>
      </nav>
    </header>

    <section class="hero">
      <p class="eyebrow">OUR GUESTBOOK</p>
      <h1>오늘의 마음을<br>한 줄로 남겨보세요.</h1>
      <p class="hero-copy">다녀간 흔적과 소소한 이야기를 함께 모으는 공간입니다.</p>
    </section>

    <section class="card composer-card">
      <div class="section-heading">
        <div>
          <p class="eyebrow">NEW MESSAGE</p>
          <h2>방명록 작성</h2>
        </div>
      </div>
      <form id="guest" class="composer">
        <!-- <input type="text" name="name" placeholder="이름을 입력하세요"> -->
        <label class="sr-only" for="guest-content">남기고 싶은 말</label>
        <input id="guest-content" type="text" name="content" placeholder="남기고 싶은 말을 입력하세요">
        <button class="button" id="guestSubmit" type="submit">등록하기</button>
      </form>
    </section>

    <section class="entries-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">MESSAGES</p>
          <h2>남겨진 이야기</h2>
        </div>
        <span class="count-badge">방명록 기록</span>
      </div>
      <% if(!rows) { %>
        <div class="card empty-state">
          <span class="empty-icon">✦</span>
          <h3>방명록이 비어있습니다.</h3>
          <p>첫 번째 이야기를 남겨보세요.</p>
        </div>
      <% } %>
      <ul class="entry-list">
        <% rows.forEach((data) => { %>
          <li class="card entry">
            <div class="entry-avatar" aria-hidden="true">✦</div>
            <div class="entry-body">
              <div class="entry-meta">
                <strong><%= data.name %></strong>
                <time><%= data.logTime %></time>
              </div>
              <p><%= data.content %></p>
            </div>
          </li>
        <% }) %>
      </ul>
    </section>
  </main>
  <script>
    document.getElementById("guest").addEventListener("submit", async (e) => {
      e.preventDefault()
      console.log("버튼 눌림")
      const form = e.currentTarget
      const body = new URLSearchParams(new FormData(form))

      await fetch("/regist", {
        method: "POST",
        body
      }).then((res) => {
        if(!res.ok) {
          // console.log(res.status)
          if(res.status===401) {
            alert("방명록을 적으려면 로그인 해야합니다.")
          }
          throw Error("에러")
        }
        alert("등록 완료!")
        window.location.reload()
        return
      }).catch(err => {
        console.log(err)
      })
    })
  </script>
</body>
</html>
