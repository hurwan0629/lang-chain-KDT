<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>회원가입</title>
  <link rel="stylesheet" href="/resources/style.css">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <a class="brand auth-brand" href="/" aria-label="방명록 홈">
      <span class="brand-mark">G</span>
      <span>Guestbook</span>
    </a>

    <section class="card auth-card">
      <div class="auth-heading">
        <p class="eyebrow">JOIN US</p>
        <h1>새로운 이야기를 시작해요.</h1>
        <p>간단한 정보만 입력하면 바로 함께할 수 있어요.</p>
      </div>

      <form id="registForm" class="auth-form">
        <div class="field">
          <label for="id">아이디</label>
          <input type="text" id="id" name="id" placeholder="사용할 아이디를 입력하세요">
        </div>
        <div class="field-row">
          <div class="field">
            <label for="password">비밀번호</label>
            <input type="password" id="password" name="password" placeholder="비밀번호 입력">
          </div>
          <div class="field">
            <label for="password-check">비밀번호 확인</label>
            <input type="password" id="password-check" placeholder="한 번 더 입력">
          </div>
        </div>
        <div class="field">
          <label for="name">이름</label>
          <input type="name" id="name" name="name" placeholder="이름을 입력하세요">
        </div>
        <button class="button button-full" type="submit" id="submitButton">회원가입하기</button>
      </form>

      <div class="auth-footer">
        <span>이미 계정이 있나요?</span>
        <a href="/login">로그인</a>
      </div>
    </section>

    <a class="back-link" href="/">← 메인 페이지로 돌아가기</a>
  </main>
  <script>
    document.getElementById("registForm").addEventListener("submit", (e) => {
      e.preventDefault()

      // 비밀번호가 잘 입력되었는지 확인
      const pswd = document.getElementById("password").value
      const pswdCheck = document.getElementById("password-check").value
      if(pswd !== pswdCheck) {
        alert("비밀번호가 일치하지 않습니다. 다시 확인해주세요")
        return
      }

      // 빈값 업는지 확인
      if(!document.getElementById("password").value 
          || !document.getElementById("password-check").value 
          || !document.getElementById("id").value 
          || !document.getElementById("name").value ) {
            alert("입력되지 않은 값이 존재합니다.")
            return
        }

      const form = e.currentTarget
      const body = new URLSearchParams(new FormData(form))

      fetch("/user", {
        credentials: "include",
        method: "PUT",
        body
      }).then((res) => {
        console.log(res.status)
        if(!res.ok) {
          if(res.status === 409) {
            alert("중첩된 아이디가 있습니다.")
          }
          else if(res.status === 400) {
            alert("올바르지 못한 입력이 존재합니다.")
          }
          else {
            alert("회원가입이 실패하였습니다.")
          }
          throw Error("에러")
          return
        }
        return res.json()
      }).then(data => {
        alert("회원가입에 성공하였습니다. 로그인 후 서비스를 이용해주세요")
        window.location = "/login"
      })
    })
  </script>
</body>
</html>
